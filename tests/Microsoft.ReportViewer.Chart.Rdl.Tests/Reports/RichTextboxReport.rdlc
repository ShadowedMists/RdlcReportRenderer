<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <ReportSections>
    <ReportSection>
      <Body>
        <ReportItems>
          <Textbox Name="TextboxRich">
            <Top>0.1in</Top>
            <Left>0.1in</Left>
            <Height>1in</Height>
            <Width>3in</Width>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>IMPORTANT: </Value>
                    <Style>
                      <FontFamily>Arial</FontFamily>
                      <FontSize>10pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>this sentence mixes a bold prefix with normal, italic-free trailing text to check multi-run wrapping across the box width.</Value>
                    <Style>
                      <FontFamily>Arial</FontFamily>
                      <FontSize>10pt</FontSize>
                    </Style>
                  </TextRun>
                </TextRuns>
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>Second paragraph in italic.</Value>
                    <Style>
                      <FontFamily>Times New Roman</FontFamily>
                      <FontSize>12pt</FontSize>
                      <FontStyle>Italic</FontStyle>
                    </Style>
                  </TextRun>
                </TextRuns>
              </Paragraph>
            </Paragraphs>
            <CanGrow>true</CanGrow>
          </Textbox>
        </ReportItems>
        <Height>2in</Height>
      </Body>
      <Width>4in</Width>
      <Page>
        <PageWidth>4in</PageWidth>
        <PageHeight>3in</PageHeight>
      </Page>
    </ReportSection>
  </ReportSections>
</Report>
