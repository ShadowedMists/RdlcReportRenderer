<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <ReportSections>
    <ReportSection>
      <Body>
        <ReportItems>
          <Map Name="SimpleMap">
            <MapViewport>
              <MapSize>
                <Width>3</Width>
                <Height>3</Height>
              </MapSize>
            </MapViewport>
            <Top>0in</Top>
            <Left>0in</Left>
            <Height>3in</Height>
            <Width>3in</Width>
          </Map>
        </ReportItems>
        <Height>3in</Height>
      </Body>
      <Width>3in</Width>
      <Page>
        <PageHeight>3.5in</PageHeight>
        <PageWidth>3.5in</PageWidth>
      </Page>
    </ReportSection>
  </ReportSections>
</Report>
