<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <ReportSections>
    <ReportSection>
      <Body>
        <ReportItems>
          <Textbox Name="TextboxRich">
            <Top>0.1in</Top>
            <Left>0.1in</Left>
            <Height>1in</Height>
            <Width>3in</Width>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>Bold red text, </Value>
                    <Style>
                      <FontFamily>Arial</FontFamily>
                      <FontSize>12pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                      <Color>Red</Color>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>then plain blue text continuing on the same line and wrapping.</Value>
                    <Style>
                      <FontFamily>Arial</FontFamily>
                      <FontSize>12pt</FontSize>
                      <Color>Blue</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style>
                  <TextAlign>Center</TextAlign>
                </Style>
              </Paragraph>
            </Paragraphs>
            <CanGrow>true</CanGrow>
          </Textbox>
        </ReportItems>
        <Height>2in</Height>
      </Body>
      <Width>4in</Width>
      <Page>
        <PageWidth>4in</PageWidth>
        <PageHeight>3in</PageHeight>
      </Page>
    </ReportSection>
  </ReportSections>
</Report>
